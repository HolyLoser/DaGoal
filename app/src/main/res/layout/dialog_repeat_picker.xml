<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card_full_radius"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repeat 🔁"
        android:textColor="@color/dagoal_primary_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Choose how often this quest recurs"
        android:textColor="@color/dagoal_text_secondary"
        android:textSize="12sp" />

    <!-- Interval Selector Pill Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Every"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <NumberPicker
            android:id="@+id/picker_repeat_interval"
            android:layout_width="wrap_content"
            android:layout_height="140dp"
            android:layout_marginEnd="12dp"
            android:solidColor="@color/dagoal_background_light" />

        <NumberPicker
            android:id="@+id/picker_repeat_unit"
            android:layout_width="wrap_content"
            android:layout_height="140dp"
            android:solidColor="@color/dagoal_background_light" />
    </LinearLayout>

    <!-- Weekday Selection Label -->
    <TextView
        android:id="@+id/tv_repeat_weekday_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="📅 On these days"
        android:textColor="@color/dagoal_primary_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Weekday Chips Row -->
    <LinearLayout
        android:id="@+id/container_repeat_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_repeat_cancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_pill"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_repeat_ok"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary_pill"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Apply"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
