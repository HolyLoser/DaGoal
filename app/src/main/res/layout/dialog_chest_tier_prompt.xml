<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_chest_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:text="🪵 Tier 1 Wooden Chest Ready!"
        android:textColor="@color/dagoal_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_chest_dialog_loot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:text="Unlock now for +30 Gold and +20 XP, or keep completing quests to reach higher chest tiers!"
        android:textColor="@color/dagoal_primary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_unlock_chest_now"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/dagoal_primary"
        android:text="Unlock Chest Now"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_keep_completing_quests"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/dagoal_secondary"
        android:text="Keep Completing Quests"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
