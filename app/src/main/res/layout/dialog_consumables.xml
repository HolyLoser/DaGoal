<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="Consumables &amp; Boosts"
        android:textColor="@color/dagoal_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Streak Protector Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_task_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🛡️"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streak Protector"
                android:textColor="@color/dagoal_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-saves streak if a day is missed"
                android:textColor="@color/dagoal_primary"
                android:textSize="12sp"
                android:alpha="0.7" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_qty_streak_protector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="x0"
            android:textColor="@color/dagoal_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- XP Boost Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_task_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⚡"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2x XP Boost"
                android:textColor="@color/dagoal_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doubles quest XP earned today"
                android:textColor="@color/dagoal_primary"
                android:textSize="12sp"
                android:alpha="0.7" />

            <TextView
                android:id="@+id/tv_qty_xp_boost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available: x0"
                android:textColor="@color/dagoal_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_activate_xp_boost"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/dagoal_primary"
            android:paddingHorizontal="12dp"
            android:text="Activate"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Gold Boost Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_task_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🪙"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2x Gold Boost"
                android:textColor="@color/dagoal_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doubles quest Gold earned today"
                android:textColor="@color/dagoal_primary"
                android:textSize="12sp"
                android:alpha="0.7" />

            <TextView
                android:id="@+id/tv_qty_gold_boost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available: x0"
                android:textColor="@color/dagoal_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_activate_gold_boost"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/dagoal_primary"
            android:paddingHorizontal="12dp"
            android:text="Activate"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_close_consumables"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/dagoal_secondary"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>
