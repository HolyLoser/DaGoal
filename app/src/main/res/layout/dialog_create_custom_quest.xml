<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_custom_quest"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2D3748"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edit_custom_quest_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/title_hint"
            android:inputType="text"
            android:autofillHints="name"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/how_to_track"
            android:textSize="13sp"
            android:textColor="#4B5563"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_custom_quest_unit_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_custom_quest_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/target_hint"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_custom_quest_unit_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/counting_hint"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_custom_quest_duration_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/row_custom_quest_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_task_card"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/time"
                android:textColor="#2D3748" />

            <TextView
                android:id="@+id/tv_custom_quest_time_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/none"
                android:textColor="#4B5563" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_custom_quest_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_task_card"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/repeat"
                android:textColor="#2D3748" />

            <TextView
                android:id="@+id/tv_custom_quest_repeat_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/none"
                android:textColor="#4B5563" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_custom_quest_repeat_ends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_task_card"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/repeat_ends"
                android:textColor="#2D3748" />

            <TextView
                android:id="@+id/tv_custom_quest_repeat_ends_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/does_not_end"
                android:textColor="#4B5563" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reward"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#2D3748"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_custom_quest_reward_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#556B43"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekbar_custom_quest_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btn_create_custom_quest"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/done"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="#778A66" />

    </LinearLayout>
</ScrollView>