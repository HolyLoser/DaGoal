<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_card_full_radius"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create a Custom Quest 📜"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Define your quest parameters and set custom rewards"
            android:textColor="@color/dagoal_text_secondary"
            android:textSize="12sp" />

        <!-- Quest Title Input -->
        <EditText
            android:id="@+id/edit_custom_quest_title"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:autofillHints="name"
            android:background="@drawable/bg_input_pill"
            android:hint="@string/title_hint"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/dagoal_primary_dark"
            android:textColorHint="@color/dagoal_text_muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Quest Description Input -->
        <EditText
            android:id="@+id/edit_custom_quest_description"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_pill"
            android:hint="Description (optional)"
            android:inputType="textMultiLine"
            android:maxLines="2"
            android:paddingHorizontal="16dp"
            android:textColor="@color/dagoal_primary_dark"
            android:textColorHint="@color/dagoal_text_muted"
            android:textSize="13sp" />

        <!-- Tracking Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="🎯 How should this be tracked?"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Spinner Wrapped in Pill Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_pill"
            android:paddingHorizontal="8dp">

            <Spinner
                android:id="@+id/spinner_custom_quest_unit_type"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:spinnerMode="dropdown"
                app:overlapAnchor="false"
                android:popupBackground="@drawable/bg_dropdown_popup"
                android:dropDownVerticalOffset="0dp" />
        </FrameLayout>

        <!-- Target Amount Input (Hidden for Tap to complete) -->
        <EditText
            android:id="@+id/edit_custom_quest_target"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input_pill"
            android:hint="@string/target_hint"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="@color/dagoal_primary_dark"
            android:textColorHint="@color/dagoal_text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Counting Label Input (Hidden unless Repetition) -->
        <EditText
            android:id="@+id/edit_custom_quest_unit_label"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input_pill"
            android:hint="@string/counting_hint"
            android:paddingHorizontal="16dp"
            android:textColor="@color/dagoal_primary_dark"
            android:textColorHint="@color/dagoal_text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Duration Row -->
        <LinearLayout
            android:id="@+id/row_custom_quest_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_task_card"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏱️ Duration"
                android:textColor="@color/dagoal_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_custom_quest_duration_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00h 30m 00s"
                android:textColor="@color/dagoal_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Block Apps Button -->
        <Button
            android:id="@+id/btn_custom_block_apps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_pill_dark"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="📱 Block Apps during quest (Optional)"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Repeat Row -->
        <LinearLayout
            android:id="@+id/row_custom_quest_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_task_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔁 Repeat"
                android:textColor="@color/dagoal_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_custom_quest_repeat_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="None ›"
                android:textColor="@color/dagoal_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quest Ends Row -->
        <LinearLayout
            android:id="@+id/row_custom_quest_repeat_ends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_task_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 Quest Ends"
                android:textColor="@color/dagoal_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_custom_quest_repeat_ends_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doesn't end ›"
                android:textColor="@color/dagoal_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Reward Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="🎁 Quest Reward"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_stats_badge_light"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_custom_quest_reward_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gold: 5 | XP: 18"
                android:textColor="@color/dagoal_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Gold / Reward Slider -->
        <SeekBar
            android:id="@+id/seekbar_custom_quest_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:minHeight="36dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:progressDrawable="@drawable/bg_seekbar_track"
            android:splitTrack="false"
            android:thumb="@drawable/bg_seekbar_thumb" />

        <!-- Bottom Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_custom_quest_cancel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_pill"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/dagoal_primary_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_create_custom_quest"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary_pill"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Create Quest"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
