<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_task_card"
    android:gravity="center_vertical"
    android:layout_marginBottom="@dimen/spacing_medium"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_normal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task Title Placeholder"
            android:textColor="@color/dagoal_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_task_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Target: 2000 steps"
            android:textColor="@color/dagoal_primary"
            android:textSize="@dimen/text_size_small"
            android:alpha="0.8" />

        <TextView
            android:id="@+id/tv_task_target_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:background="@drawable/bg_target_pill"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="2dp"
            android:text="5.0 km"
            android:textColor="@color/dagoal_primary"
            android:textSize="@dimen/text_size_micro"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Manual Quest Progress Bar -->
        <ProgressBar
            android:id="@+id/pb_task_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_bar_height_thin"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginEnd="@dimen/spacing_normal"
            android:progress="0"
            android:progressTint="@color/dagoal_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Pedometer / Auto-tracked Icon -->
    <ImageView
        android:id="@+id/iv_auto_tracked_icon"
        android:layout_width="@dimen/icon_size_medium"
        android:layout_height="@dimen/icon_size_medium"
        android:alpha="0.7"
        android:clickable="false"
        android:contentDescription="Auto-tracked quest"
        android:focusable="false"
        android:src="@android:drawable/ic_menu_compass"
        android:visibility="gone"
        app:tint="@color/dagoal_primary" />

    <!-- Start Timer / Avoidance Button -->
    <Button
        android:id="@+id/btn_start_avoidance"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="@dimen/touch_target_min_width"
        android:background="@drawable/bg_button_primary_pill"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="@dimen/spacing_normal"
        android:text="Start"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_small"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Increment Progress Button -->
    <Button
        android:id="@+id/btn_increment_progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="@dimen/touch_target_min_width"
        android:minHeight="@dimen/touch_target_min_height"
        android:background="@drawable/bg_button_primary_pill"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_headline"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Clean Manual Complete Button -->
    <Button
        android:id="@+id/btn_manual_complete"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="@dimen/touch_target_min_width"
        android:background="@drawable/bg_button_primary_pill"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:text="Complete"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_small"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Legacy Checkbox (Hidden) -->
    <CheckBox
        android:id="@+id/btn_shuffle_item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Separate Shuffle Button -->
    <ImageButton
        android:id="@+id/btn_card_shuffle"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginStart="@dimen/spacing_small"
        android:background="@android:color/transparent"
        android:contentDescription="Shuffle Quest"
        android:scaleType="fitCenter"
        android:src="@drawable/shuffle_icon"
        android:visibility="gone" />

    <!-- Custom Quest Completed Label -->
    <Button
        android:id="@+id/btn_quest_completed_label"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min_height"
        android:minWidth="@dimen/touch_target_min_width"
        android:background="@drawable/bg_quest_completed_button"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:text="Quest Completed"
        android:textAllCaps="false"
        android:textColor="@color/dagoal_secondary"
        android:textSize="@dimen/text_size_caption"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@null" />

</LinearLayout>
