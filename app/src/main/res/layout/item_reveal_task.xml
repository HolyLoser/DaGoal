<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_task_card"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task Title Placeholder"
            android:textColor="@color/dagoal_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_task_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Target: 2000 steps"
            android:textColor="@color/dagoal_primary"
            android:textSize="12sp"
            android:alpha="0.8" />

        <TextView
            android:id="@+id/tv_task_target_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_target_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:text="5.0 km"
            android:textColor="@color/dagoal_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Manual Quest Progress Bar -->
        <ProgressBar
            android:id="@+id/pb_task_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:progress="0"
            android:progressTint="@color/dagoal_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Pedometer / Auto-tracked Icon -->
    <ImageView
        android:id="@+id/iv_auto_tracked_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:alpha="0.7"
        android:clickable="false"
        android:contentDescription="Auto-tracked quest"
        android:focusable="false"
        android:src="@android:drawable/ic_menu_compass"
        android:visibility="gone"
        app:tint="@color/dagoal_primary" />

    <!-- Start Timer / Avoidance Button -->
    <Button
        android:id="@+id/btn_start_avoidance"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:backgroundTint="@color/dagoal_secondary"
        android:paddingHorizontal="16dp"
        android:text="Start"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Increment Progress Button -->
    <Button
        android:id="@+id/btn_increment_progress"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:backgroundTint="@color/dagoal_secondary"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Completion / Shuffle Checkbox (Hidden if not generic or when using custom button) -->
    <CheckBox
        android:id="@+id/btn_shuffle_item"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:drawable/checkbox_on_background"
        android:button="@null"
        android:clickable="false"
        android:contentDescription="Complete Task Checkbox"
        android:focusable="false"
        android:visibility="visible" />

    <!-- Custom Quest Completed Button -->
    <Button
        android:id="@+id/btn_quest_completed_label"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_quest_completed_button"
        android:paddingHorizontal="12dp"
        android:text="Quest Completed"
        android:textAllCaps="false"
        android:textColor="@color/dagoal_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@null" />

</LinearLayout>
