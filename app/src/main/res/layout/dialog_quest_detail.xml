<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_task_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_achievement_badge" />

            <TextView
                android:id="@+id/tv_quest_detail_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="\uD83D\uDCCB"
                android:textSize="26sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_quest_detail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quest Title"
                android:textColor="@color/dagoal_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_quest_detail_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goal description"
                android:textColor="@color/dagoal_primary"
                android:textSize="13sp"
                android:alpha="0.7"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_quest_detail_action"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_achievement_rank_badge"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@android:color/white"
            android:contentDescription="Remove quest" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_quest_detail_difficulty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quest Difficulty: Easy"
        android:textColor="@color/dagoal_primary"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_quest_detail_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reward: 10 Gold / 15 XP"
        android:textColor="@color/dagoal_primary"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_quest_detail_progress_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Progress"
        android:textColor="@color/dagoal_primary"
        android:textSize="13sp"
        android:alpha="0.7"
        android:layout_marginBottom="6dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <ProgressBar
            android:id="@+id/pb_quest_detail_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:progressTint="@color/dagoal_secondary"
            android:progressBackgroundTint="@color/dagoal_surface"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_quest_detail_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="0/5"
            android:textColor="@color/dagoal_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <Button
        android:id="@+id/btn_quest_detail_close"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="@color/dagoal_secondary"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

</LinearLayout>