<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_surface_card"
    android:orientation="vertical"
    android:paddingLeft="@dimen/spacing_normal"
    android:paddingRight="@dimen/spacing_normal">

    <LinearLayout
        android:id="@+id/drag_handle_touch_area"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min_height"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <View
            android:layout_width="50dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_drag_handle" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_quest_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/quest_icon"
                    app:tint="@color/dagoal_primary" />

                <TextView
                    android:id="@+id/tv_quests_remaining_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/no_quest_available"
                    android:textColor="@color/dagoal_primary"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_custom_quest_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_task_card"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_normal"
                    android:paddingVertical="@dimen/spacing_small"
                    android:text="@string/custom_slots_default"
                    android:textColor="@color/dagoal_primary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/container_active_dashboard_quests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_normal"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_no_quests_available"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="@dimen/spacing_huge"
                    android:text="@string/no_quest_available"
                    android:textColor="@color/dagoal_primary"
                    android:textSize="@dimen/text_size_header"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <Button
                android:id="@+id/btn_dashboard_add_goal"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="@dimen/spacing_extra_large"
                android:background="@drawable/bg_button_primary_pill"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/add_a_goal"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="@string/completed_quests"
                android:textColor="@color/dagoal_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/container_completed_dashboard_quests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
