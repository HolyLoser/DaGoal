<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dagoal_background_light"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btn_streak_info_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Streak"
            android:textColor="@color/dagoal_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:paddingTop="0dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_task_card"
            android:padding="16dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/tv_streak_info_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/dagoal_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Streak"
                android:textColor="@color/dagoal_primary"
                android:textSize="12sp"
                android:alpha="0.7" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_task_card"
            android:padding="16dp"
            android:layout_marginStart="8dp">
            <TextView
                android:id="@+id/tv_streak_info_longest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/dagoal_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Longest Streak"
                android:textColor="@color/dagoal_primary"
                android:textSize="12sp"
                android:alpha="0.7" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_streak_prediction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_task_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="🎯"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_prediction_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streak Goal Prediction"
                android:textColor="@color/dagoal_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_prediction_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Predict how long your streak will last for bonus rewards!"
                android:textColor="@color/dagoal_primary"
                android:textSize="11sp"
                android:alpha="0.7" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_set_prediction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/dagoal_primary"
            android:paddingHorizontal="12dp"
            android:text="Set Goal"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:text="Every 3-day unbroken streak unlocks a chest 🎁"
        android:textColor="@color/dagoal_primary"
        android:textSize="12sp"
        android:alpha="0.7" />

    <GridView
        android:id="@+id/grid_streak_calendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:numColumns="7"
        android:padding="16dp"
        android:stretchMode="columnWidth" />

</LinearLayout>