<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:padding="1dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center">

        <View
            android:id="@+id/view_calendar_day_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_calendar_day_circle" />

        <View
            android:id="@+id/view_calendar_today_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_calendar_today_ring"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_calendar_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/view_calendar_today_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_circle_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_calendar_day_chest"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="🎁"
            android:textSize="11sp"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
