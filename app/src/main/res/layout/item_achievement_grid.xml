<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_achievement_item"
    android:layout_width="match_parent"
    android:layout_height="170dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_achievement_card_item"
    android:padding="8dp"
    android:elevation="2dp">

    <!-- Circle Icon Frame with Badge Overlay -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp">

        <View
            android:id="@+id/view_achievement_badge_bg"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_achievement_badge" />

        <TextView
            android:id="@+id/tv_achievement_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/loading"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tv_achievement_rank_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_achievement_rank_badge"
            android:gravity="center"
            android:text="@string/loading"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Title with Dynamic Auto-Sizing Font -->
    <TextView
        android:id="@+id/tv_achievement_grid_title"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="@string/loading"
        android:textColor="@color/dagoal_primary_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeMaxTextSize="12sp"
        app:autoSizeStepGranularity="1sp" />

    <!-- Description with Dynamic Auto-Sizing Font -->
    <TextView
        android:id="@+id/tv_achievement_grid_desc"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="@string/loading"
        android:textColor="@color/dagoal_text_secondary"
        android:textSize="10sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="7sp"
        app:autoSizeMaxTextSize="10sp"
        app:autoSizeStepGranularity="1sp"
        android:layout_marginBottom="4dp" />

    <!-- Rank Status Pill Tag -->
    <TextView
        android:id="@+id/tv_achievement_rank_label"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="@string/loading"
        android:textColor="#64748B"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:background="@drawable/bg_achievement_rank_pill_unranked" />

</LinearLayout>
