<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card_full_radius"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:text="💇 Hair Color Picker"
        android:textColor="@color/dagoal_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Color Preview Swatch & Hex Code -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <View
            android:id="@+id/view_hair_color_preview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_preset"
            android:backgroundTint="#1E1E1E" />

        <TextView
            android:id="@+id/tv_hair_hex_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="#1E1E1E"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Red Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="R:"
            android:textColor="#DC143C"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sb_hair_red"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255"
            android:progress="30"
            android:progressDrawable="@drawable/bg_seekbar_track_red"
            android:thumb="@drawable/bg_seekbar_thumb_red"
            android:splitTrack="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/tv_hair_red_val"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="30"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Green Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="G:"
            android:textColor="#2E8B57"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sb_hair_green"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255"
            android:progress="30"
            android:progressDrawable="@drawable/bg_seekbar_track_green"
            android:thumb="@drawable/bg_seekbar_thumb_green"
            android:splitTrack="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/tv_hair_green_val"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="30"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Blue Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="B:"
            android:textColor="#1E90FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sb_hair_blue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255"
            android:progress="30"
            android:progressDrawable="@drawable/bg_seekbar_track_blue"
            android:thumb="@drawable/bg_seekbar_thumb_blue"
            android:splitTrack="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/tv_hair_blue_val"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="30"
            android:textColor="@color/dagoal_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Hair Presets Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Hair Color Presets:"
        android:textColor="@color/dagoal_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Presets Grid Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="vertical">

        <!-- Row 1 Presets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/preset_hair_white"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle_preset"
                android:backgroundTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_hair_silver"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle_preset"
                android:backgroundTint="#D3D3D3"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_hair_black"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle_preset"
                android:backgroundTint="#1E1E1E"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_hair_brown"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle_preset"
                android:backgroundTint="#3B2219"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_hair_blonde"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle_preset"
                android:backgroundTint="#E6BE75"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Row 2 Presets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/preset_hair_auburn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle_preset"
                android:backgroundTint="#A52A2A"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_hair_pink"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle_preset"
                android:backgroundTint="#FFB6C1"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_hair_skyblue"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle_preset"
                android:backgroundTint="#87CEEB"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_hair_emerald"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle_preset"
                android:backgroundTint="#2E8B57"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_hair_purple"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle_preset"
                android:backgroundTint="#9370DB"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_apply_hair_color"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_primary_pill"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Apply Hair Color"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
