<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card_full_radius"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:text="👁️ Iris Color Picker"
        android:textColor="@color/dagoal_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Color Preview Swatch & Name/Hex Code -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <View
            android:id="@+id/view_eye_color_preview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_preset"
            android:backgroundTint="#1E1E1E" />

        <TextView
            android:id="@+id/tv_eye_color_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Deep Black"
            android:textColor="@color/dagoal_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_eye_hex_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="#1E1E1E"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Presets Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Iris Color Presets:"
        android:textColor="@color/dagoal_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Presets Grid Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="vertical">

        <!-- Row 1: Black, Dark Brown, Chestnut Brown, Hazel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/preset_iris_black"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_iris_darkbrown"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_iris_brown"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_iris_hazel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Row 2: Amber Gold, Emerald Green, Turquoise, Sapphire Blue -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/preset_iris_amber"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_iris_green"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_iris_turquoise"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_iris_sapphire"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Row 3: Sky Blue, Steel Gray, Purple, Ruby Red -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/preset_iris_skyblue"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_iris_gray"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_iris_purple"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/preset_iris_crimson"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_apply_eye_color"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_primary_pill"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Apply Eye Color"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
