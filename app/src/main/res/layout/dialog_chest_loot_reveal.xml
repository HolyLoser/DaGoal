<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_loot_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You Got"
        android:textColor="@color/dagoal_primary_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/iv_loot_dialog_chest_image"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:scaleType="fitCenter"
        android:src="@drawable/chest_wood"
        android:layout_marginBottom="16dp" />

    <!-- Container for Reward Cards (2 Centered Rows) -->
    <LinearLayout
        android:id="@+id/container_loot_cards_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:id="@+id/container_loot_cards_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|top"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/container_loot_cards_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal|top"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_claim_loot_done"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_button_primary_pill"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Collect Rewards! 🎉"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
