<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_extra_large">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add a goal"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold"
            android:textColor="@color/dagoal_primary_dark"
            android:layout_marginBottom="@dimen/spacing_normal" />

        <TextView
            android:id="@+id/tv_chooser_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 custom quests remaining this week"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/dagoal_text_secondary"
            android:layout_marginBottom="@dimen/spacing_large" />

        <Button
            android:id="@+id/btn_chooser_manual"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_pill_dark"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Create Manually"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <Button
            android:id="@+id/btn_chooser_describe"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_pill"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Describe It (AI)"
            android:textColor="@color/dagoal_primary_dark"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
