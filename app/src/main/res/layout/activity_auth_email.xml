<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_auth_email_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dagoal_primary"
    android:padding="@dimen/spacing_extra_large">

    <!-- Top Left Back Button -->
    <ImageButton
        android:id="@+id/btn_back_email"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:background="@drawable/bg_auth_pill"
        android:contentDescription="Back"
        android:padding="@dimen/spacing_small"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/dagoal_primary_dark" />

    <!-- DaGoal Logo Centered -->
    <ImageView
        android:id="@+id/img_email_logo"
        android:layout_width="@dimen/logo_width_medium"
        android:layout_height="@dimen/logo_height_medium"
        android:layout_marginTop="@dimen/spacing_normal"
        android:contentDescription="DaGoal Logo"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_nobg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back_email" />

    <!-- Email Input Box -->
    <LinearLayout
        android:id="@+id/layout_email_input"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_standard"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_huge"
        android:background="@drawable/bg_auth_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_email_logo">

        <EditText
            android:id="@+id/edit_auth_email"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:textColor="@color/dagoal_primary_dark"
            android:textColorHint="@color/dagoal_hint"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Password Input Box -->
    <LinearLayout
        android:id="@+id/layout_password_input"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_standard"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_normal"
        android:background="@drawable/bg_auth_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_email_input">

        <EditText
            android:id="@+id/edit_auth_password"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColor="@color/dagoal_primary_dark"
            android:textColorHint="@color/dagoal_hint"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_toggle_password_visibility"
            android:layout_width="@dimen/touch_target_min_width"
            android:layout_height="@dimen/touch_target_min_height"
            android:clickable="true"
            android:contentDescription="Toggle Visibility"
            android:focusable="true"
            android:padding="@dimen/spacing_small"
            android:src="@android:drawable/ic_menu_view"
            app:tint="@color/dagoal_primary_dark" />
    </LinearLayout>

    <!-- Password Helper Text -->
    <TextView
        android:id="@+id/tv_password_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:text="Password must be at least 6 characters"
        android:textColor="@color/dagoal_surface"
        android:textSize="@dimen/text_size_small"
        app:layout_constraintStart_toStartOf="@id/layout_password_input"
        app:layout_constraintTop_toBottomOf="@id/layout_password_input" />

    <!-- Login Button -->
    <Button
        android:id="@+id/btn_email_login"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_standard"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_extra_large"
        android:background="@drawable/bg_auth_pill_disabled"
        android:enabled="false"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="@color/dagoal_primary_dark"
        android:textSize="@dimen/text_size_header"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_password_hint" />

    <!-- Forgot Password Link -->
    <TextView
        android:id="@+id/tv_forgot_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_normal"
        android:clickable="true"
        android:focusable="true"
        android:minWidth="@dimen/touch_target_min_width"
        android:minHeight="@dimen/touch_target_min_height"
        android:padding="@dimen/spacing_small"
        android:text="Forgot password?"
        android:textColor="@color/dagoal_background_light"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_email_login" />

    <!-- Don't have an account? Sign Up -->
    <TextView
        android:id="@+id/tv_go_to_signup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:clickable="true"
        android:focusable="true"
        android:minWidth="@dimen/touch_target_min_width"
        android:minHeight="@dimen/touch_target_min_height"
        android:padding="@dimen/spacing_small"
        android:text="Don't have an account? Sign Up"
        android:textColor="@color/dagoal_surface"
        android:textSize="@dimen/text_size_subhead"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_forgot_password" />

</androidx.constraintlayout.widget.ConstraintLayout>
