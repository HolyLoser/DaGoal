<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_avatar_creation_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_edit_character">

    <!-- Character Preview Container -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/bottom_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/avatar_square_canvas"
            android:layout_width="@dimen/avatar_preview_square_size"
            android:layout_height="@dimen/avatar_preview_square_size"
            android:layout_gravity="bottom|center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/iv_composited_avatar_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/btn_back_avatar"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginStart="@dimen/spacing_extra_large"
        android:layout_marginTop="@dimen/spacing_giant"
        android:background="@drawable/bg_circle_primary"
        android:contentDescription="@string/back"
        android:padding="@dimen/spacing_medium"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_revert"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Left Color Palette Sidebar Bar -->
    <LinearLayout
        android:id="@+id/sidebar_colors"
        android:layout_width="@dimen/wardrobe_sidebar_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_avatar_sidebar"
        android:elevation="@dimen/card_elevation"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COLOR"
            android:textColor="@color/dagoal_primary"
            android:textSize="@dimen/text_size_micro"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_tiny" />

        <TextView
            android:id="@+id/color_swatch_eye_picker"
            android:layout_width="@dimen/touch_target_min_width"
            android:layout_height="@dimen/touch_target_min_height"
            android:layout_marginVertical="3dp"
            android:background="@drawable/bg_circle_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🎨"
            android:textSize="@dimen/text_size_header"
            android:visibility="gone" />

        <TextView
            android:id="@+id/color_swatch_hair_picker"
            android:layout_width="@dimen/touch_target_min_width"
            android:layout_height="@dimen/touch_target_min_height"
            android:layout_marginVertical="3dp"
            android:background="@drawable/bg_circle_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="💇"
            android:textSize="@dimen/text_size_header"
            android:visibility="gone" />

        <View
            android:id="@+id/color_swatch_brown"
            android:layout_width="@dimen/touch_target_min_width"
            android:layout_height="@dimen/touch_target_min_height"
            android:layout_marginVertical="3dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="#6D4C41"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/color_swatch_black"
            android:layout_width="@dimen/touch_target_min_width"
            android:layout_height="@dimen/touch_target_min_height"
            android:layout_marginVertical="3dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="#1E1E1E"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/color_swatch_peach"
            android:layout_width="@dimen/touch_target_min_width"
            android:layout_height="@dimen/touch_target_min_height"
            android:layout_marginVertical="3dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="#FFC2B4"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/color_swatch_orange"
            android:layout_width="@dimen/touch_target_min_width"
            android:layout_height="@dimen/touch_target_min_height"
            android:layout_marginVertical="3dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="#FF7A38"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/color_swatch_darkred"
            android:layout_width="@dimen/touch_target_min_width"
            android:layout_height="@dimen/touch_target_min_height"
            android:layout_marginVertical="3dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="#800000"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/color_swatch_white"
            android:layout_width="@dimen/touch_target_min_width"
            android:layout_height="@dimen/touch_target_min_height"
            android:layout_marginVertical="3dp"
            android:background="@drawable/bg_circle_preset"
            android:backgroundTint="#FFFFFF"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Right Category Sidebar -->
    <LinearLayout
        android:id="@+id/sidebar_categories"
        android:layout_width="@dimen/wardrobe_category_sidebar_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_avatar_sidebar"
        android:elevation="@dimen/card_elevation"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/tab_skin"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:layout_marginVertical="@dimen/spacing_tiny"
                    android:background="@drawable/bg_avatar_category_item"
                    android:contentDescription="@string/skin_color"
                    android:padding="@dimen/spacing_small"
                    android:scaleType="centerInside"
                    android:src="@drawable/skin_category_icon" />

                <ImageButton
                    android:id="@+id/tab_hair"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:layout_marginVertical="@dimen/spacing_tiny"
                    android:background="@drawable/bg_avatar_category_item"
                    android:contentDescription="@string/hair"
                    android:padding="@dimen/spacing_small"
                    android:scaleType="centerInside"
                    android:src="@drawable/hair_category_icon" />

                <ImageButton
                    android:id="@+id/tab_eyes"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:layout_marginVertical="@dimen/spacing_tiny"
                    android:background="@drawable/bg_avatar_category_item"
                    android:contentDescription="@string/eyes"
                    android:padding="@dimen/spacing_small"
                    android:scaleType="centerInside"
                    android:src="@drawable/eye_category_icon" />

                <ImageButton
                    android:id="@+id/tab_nose"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:layout_marginVertical="@dimen/spacing_tiny"
                    android:background="@drawable/bg_avatar_category_item"
                    android:contentDescription="@string/nose"
                    android:padding="@dimen/spacing_small"
                    android:scaleType="centerInside"
                    android:src="@drawable/nose_category_icon" />

                <ImageButton
                    android:id="@+id/tab_mouth"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:layout_marginVertical="@dimen/spacing_tiny"
                    android:background="@drawable/bg_avatar_category_item"
                    android:contentDescription="@string/mouth"
                    android:padding="@dimen/spacing_small"
                    android:scaleType="centerInside"
                    android:src="@drawable/lips_category_icon" />

                <ImageButton
                    android:id="@+id/tab_cheeks"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:layout_marginVertical="@dimen/spacing_tiny"
                    android:background="@drawable/bg_avatar_category_item"
                    android:contentDescription="@string/cheeks"
                    android:padding="@dimen/spacing_small"
                    android:scaleType="centerInside"
                    android:src="@drawable/blush_category_icon" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- Bottom Selection Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_surface_card"
        android:elevation="@dimen/card_elevation_raised"
        android:padding="@dimen/spacing_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintTop_toBottomOf="@+id/preview_container">

        <ScrollView
            android:id="@+id/asset_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/spacing_normal"
            app:layout_constraintBottom_toTopOf="@+id/btn_save_avatar"
            app:layout_constraintTop_toTopOf="parent">

            <GridLayout
                android:id="@+id/grid_assets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:alignmentMode="alignBounds"
                android:columnCount="3"
                android:padding="@dimen/spacing_small"
                android:rowOrderPreserved="false" />
        </ScrollView>

        <Button
            android:id="@+id/btn_save_avatar"
            android:layout_width="@dimen/logo_width_large"
            android:layout_height="54dp"
            android:layout_marginBottom="@dimen/spacing_extra_large"
            android:background="@drawable/bg_button_primary_pill"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/create"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
