<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_auth_options_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dagoal_primary"
    android:padding="@dimen/spacing_extra_large">

    <!-- Top Left Back Button -->
    <ImageButton
        android:id="@+id/btn_back_options"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:background="@drawable/bg_auth_pill"
        android:contentDescription="Back"
        android:padding="@dimen/spacing_small"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/dagoal_primary_dark" />

    <!-- DaGoal Logo Centered -->
    <ImageView
        android:id="@+id/img_options_logo"
        android:layout_width="@dimen/logo_width_medium"
        android:layout_height="@dimen/logo_height_large"
        android:layout_marginTop="@dimen/spacing_huge"
        android:contentDescription="DaGoal Logo"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_nobg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back_options" />

    <!-- 1. Email Option Button -->
    <Button
        android:id="@+id/btn_opt_email"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_giant"
        android:background="@drawable/bg_auth_pill"
        android:text="Email"
        android:textAllCaps="false"
        android:textColor="@color/dagoal_primary_dark"
        android:textSize="@dimen/text_size_header"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_options_logo" />

    <!-- 2. Gmail Option Container -->
    <LinearLayout
        android:id="@+id/btn_opt_gmail"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_normal"
        android:background="@drawable/bg_auth_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_opt_email">

        <ImageView
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:contentDescription="Gmail Icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gmail" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:text="Gmail"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Facebook Option Container -->
    <LinearLayout
        android:id="@+id/btn_opt_facebook"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_normal"
        android:background="@drawable/bg_auth_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_opt_gmail">

        <ImageView
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:contentDescription="Facebook Icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_facebook" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:text="Facebook"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
