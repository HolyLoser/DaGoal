<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_app_selection_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dagoal_primary"
    android:padding="@dimen/spacing_large">

    <!-- Top Navigation Bar Header -->
    <TextView
        android:id="@+id/tv_app_selection_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="App Tracking"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_headline"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_app_selection_subheader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0.9"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:text="We selected some apps that we think take most of your time.\nFeel free to deselect or add more apps that take up your time."
        android:textColor="@color/dagoal_background_light"
        android:textSize="@dimen/text_size_caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_app_selection_header" />

    <!-- App Checklist Container Frame -->
    <LinearLayout
        android:id="@+id/card_app_checklist_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_surface_card_full_radius"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium"
        app:layout_constraintBottom_toTopOf="@id/btn_app_selection_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_app_selection_subheader">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/container_app_checklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <Button
        android:id="@+id/btn_app_selection_continue"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginBottom="@dimen/spacing_small"
        android:background="@drawable/bg_button_pill_surface"
        android:text="Proceed"
        android:textAllCaps="false"
        android:textColor="@color/dagoal_primary_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
