<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_wardrobe_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="@string/my_outfits_bag"
        android:textColor="@color/dagoal_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/card_wardrobe_avatar_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_task_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/avatar_me_host"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_circle_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_equipped_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equipped: None"
                android:textColor="@color/dagoal_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_equipped_item_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select an item below to equip"
                android:textColor="@color/dagoal_primary"
                android:textSize="12sp"
                android:alpha="0.7" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grid_wardrobe_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="16dp"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            android:verticalSpacing="16dp" />
    </FrameLayout>

    <Button
        android:id="@+id/btn_wardrobe_action"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="@color/dagoal_secondary"
        android:text="@string/equip_item"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold" />
</LinearLayout>
