<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dagoal_primary"
    android:padding="@dimen/spacing_extra_large">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_main_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.4" />

    <!-- DaGoal Brand Logo Centered -->
    <ImageView
        android:id="@+id/img_start_logo"
        android:layout_width="@dimen/logo_width_large"
        android:layout_height="@dimen/logo_height_large"
        android:contentDescription="DaGoal Logo"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_nobg"
        app:layout_constraintBottom_toTopOf="@+id/btn_start_signup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Create an Avatar Button -->
    <Button
        android:id="@+id/btn_start_signup"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_huge"
        android:background="@drawable/bg_auth_pill"
        android:text="Create an Avatar"
        android:textAllCaps="false"
        android:textColor="@color/dagoal_primary_dark"
        android:textSize="@dimen/text_size_header"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/btn_start_login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_start_logo" />

    <!-- Login Button -->
    <Button
        android:id="@+id/btn_start_login"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_normal"
        android:background="@drawable/bg_auth_pill"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="@color/dagoal_primary_dark"
        android:textSize="@dimen/text_size_header"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/tv_terms_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_start_signup" />

    <!-- Terms and Privacy Policy Footer -->
    <TextView
        android:id="@+id/tv_terms_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_normal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:minWidth="@dimen/touch_target_min_width"
        android:minHeight="@dimen/touch_target_min_height"
        android:padding="@dimen/spacing_small"
        android:text="By proceeding, you agree to our\nTerms of Service and Privacy Policy"
        android:textColor="@color/dagoal_background_light"
        android:textSize="@dimen/text_size_caption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
