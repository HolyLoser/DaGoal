<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Card Surface Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_task_card"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Top Avoidance Interrupt Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_avoidance_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/avoidance_icon_desc"
                android:src="@drawable/ic_info_circle"
                app:tint="#B45309" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="@string/avoidance_interrupt_badge"
                android:textColor="#92400E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quest / Block Title -->
        <TextView
            android:id="@+id/tv_overlay_quest_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/avoidance_title"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtitle / Warning Message -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/avoidance_message"
            android:textColor="@color/dagoal_text_primary"
            android:textSize="14sp" />

        <!-- Current Quest Rewards Badge -->
        <TextView
            android:id="@+id/tv_overlay_quest_rewards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="🪙 10 Gold   •   ⚡ 15 XP"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Primary Action Button: I Understand / Return to DaGoal -->
        <Button
            android:id="@+id/btn_overlay_understand"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_primary_pill"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/understand"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Secondary Action Button: Ignore for 5 minutes -->
        <Button
            android:id="@+id/btn_overlay_ignore"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_pill"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Dismiss"
            android:textAllCaps="false"
            android:textColor="@color/dagoal_primary_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
