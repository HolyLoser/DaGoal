<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tab_end_by_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="End by date"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#556B43"
            android:gravity="center"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tab_end_by_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="End by count"
            android:textSize="15sp"
            android:textColor="#A0AEC0"
            android:gravity="center"
            android:padding="8dp" />
    </LinearLayout>

    <CalendarView
        android:id="@+id/calendar_repeat_end_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible" />

    <NumberPicker
        android:id="@+id/picker_repeat_end_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_repeat_ends_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#4B5563"
            android:background="@android:color/transparent"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btn_repeat_ends_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK"
            android:textColor="#556B43"
            android:textStyle="bold"
            android:background="@android:color/transparent" />
    </LinearLayout>

</LinearLayout>