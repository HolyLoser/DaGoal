<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_task_card"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_settings_row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Row title"
            android:textColor="@color/dagoal_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_settings_row_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Row subtitle"
            android:textColor="@color/dagoal_primary"
            android:textSize="12sp"
            android:alpha="0.7"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_settings_row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/dagoal_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>