<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_margin="8dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_bordered"
            android:backgroundTint="#1E293B" />

        <ImageView
            android:id="@+id/iv_loot_card_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/coins_icon" />

        <TextView
            android:id="@+id/tv_loot_card_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:text="+23"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_loot_card_name"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="gold"
        android:textColor="#1E293B"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
