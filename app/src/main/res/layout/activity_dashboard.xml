<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_dashboard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quest_sec_bg"
    android:fitsSystemWindows="false">

    <FrameLayout
        android:id="@+id/dashboard_bg_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_dashboard_bg_next"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_home" />

        <ImageView
            android:id="@+id/iv_dashboard_bg_active"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_home" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dashboard_main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Status Bar Breakpoint Guideline (Percent) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_header_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.02" />

        <!-- Collapsed Dashboard Panel Surface Anchor -->
        <View
            android:id="@+id/view_collapsed_surface_anchor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/collapsed_surface_anchor_margin"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@+id/bottom_nav_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 1. Top Preview Area: Background & Stats -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/panel_avatar_host"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/view_collapsed_surface_anchor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- HUD Stat Badges -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/stats_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:paddingHorizontal="@dimen/spacing_normal"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Level Badge (Top Left) -->
                <TextView
                    android:id="@+id/tv_global_dashboard_lvl"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/xp_badge_height"
                    android:minWidth="@dimen/touch_target_min_width"
                    android:background="@drawable/bg_stats_badge_primary"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_medium"
                    android:text="@string/lvl_placeholder"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- XP Badge (Centered) -->
                <LinearLayout
                    android:id="@+id/xp_badge_container"
                    android:layout_width="@dimen/xp_badge_width"
                    android:layout_height="@dimen/xp_badge_height"
                    android:background="@drawable/bg_stats_badge_light"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_small"
                    app:layout_constraintBottom_toBottomOf="@id/tv_global_dashboard_lvl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_global_dashboard_lvl">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:contentDescription="@null"
                        android:src="@drawable/exp_icon" />

                    <ProgressBar
                        android:id="@+id/pb_global_dashboard_xp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="50"
                        android:progressDrawable="@drawable/bg_xp_progress_track" />

                    <TextView
                        android:id="@+id/tv_global_dashboard_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Gold Badge (Top Right) -->
                <LinearLayout
                    android:id="@+id/gold_badge_container"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/xp_badge_height"
                    android:minWidth="@dimen/touch_target_min_width"
                    android:background="@drawable/bg_stats_badge_light"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_medium"
                    app:layout_constraintBottom_toBottomOf="@id/tv_global_dashboard_lvl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_global_dashboard_lvl">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:contentDescription="@null"
                        android:src="@drawable/coins_icon" />

                    <TextView
                        android:id="@+id/tv_global_dashboard_gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_tiny"
                        android:text="@string/gold_placeholder"
                        android:textColor="@color/dagoal_primary_dark"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Active XP Boost Timer Badge (Below XP Badge Centered) -->
                <LinearLayout
                    android:id="@+id/xp_boost_badge_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:background="@drawable/bg_stats_badge_light"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_medium"
                    android:paddingVertical="@dimen/spacing_tiny"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="@id/xp_badge_container"
                    app:layout_constraintStart_toStartOf="@id/xp_badge_container"
                    app:layout_constraintTop_toBottomOf="@id/xp_badge_container">

                    <ImageView
                        android:id="@+id/iv_global_dashboard_xp_boost_icon"
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_2x_xp" />

                    <TextView
                        android:id="@+id/tv_global_dashboard_xp_boost_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_tiny"
                        android:text="05:59:50"
                        android:textColor="@color/dagoal_primary"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Active Gold Boost Timer Badge (Below Gold Badge Top Right) -->
                <LinearLayout
                    android:id="@+id/gold_boost_badge_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:background="@drawable/bg_stats_badge_light"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_medium"
                    android:paddingVertical="@dimen/spacing_tiny"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/gold_badge_container">

                    <ImageView
                        android:id="@+id/iv_global_dashboard_gold_boost_icon"
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_2x_gold" />

                    <TextView
                        android:id="@+id/tv_global_dashboard_gold_boost_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_tiny"
                        android:text="05:59:50"
                        android:textColor="@color/dagoal_primary"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Vertical Chest Progress Bar (Anchored to Left side of Avatar Host) -->
            <LinearLayout
                android:id="@+id/card_chest_bar"
                android:layout_width="@dimen/chest_bar_width"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_normal"
                android:minWidth="@dimen/touch_target_min_width"
                android:minHeight="@dimen/touch_target_min_height"
                android:background="@drawable/bg_task_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stats_header">

                <ImageView
                    android:id="@+id/iv_chest_bar_icon"
                    android:layout_width="@dimen/icon_size_extra_large"
                    android:layout_height="@dimen/icon_size_extra_large"
                    android:scaleType="fitCenter"
                    android:src="@drawable/chest_wood" />

                <!-- Vertical Progress Bar Track -->
                <FrameLayout
                    android:id="@+id/view_chest_bar_track"
                    android:layout_width="@dimen/chest_bar_track_width"
                    android:layout_height="@dimen/chest_bar_track_height"
                    android:layout_marginVertical="@dimen/spacing_small"
                    android:background="@color/dagoal_hint">

                    <View
                        android:id="@+id/view_chest_bar_fill"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="bottom"
                        android:background="@color/dagoal_xp_purple" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_chest_bar_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/3"
                    android:textColor="@color/dagoal_primary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Avatar Character Canvas (Constrained Beside Chest Bar) -->
            <FrameLayout
                android:id="@+id/avatar_host_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginEnd="@dimen/spacing_small"
                app:layout_constrainedWidth="true"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/panel_wardrobe_sidebar"
                app:layout_constraintStart_toEndOf="@id/card_chest_bar"
                app:layout_constraintTop_toBottomOf="@id/stats_header" />

            <!-- Wardrobe Right-Side Category Sidebar (Right Side) -->
            <LinearLayout
                android:id="@+id/panel_wardrobe_sidebar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_normal"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stats_header">

                <!-- 1. Hat / Head Slot Button -->
                <FrameLayout
                    android:id="@+id/btn_wardrobe_filter_hat"
                    android:layout_width="@dimen/wardrobe_sidebar_button_size"
                    android:layout_height="@dimen/wardrobe_sidebar_button_size"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/view_bg_filter_hat"
                        android:layout_width="@dimen/wardrobe_sidebar_button_size"
                        android:layout_height="@dimen/wardrobe_sidebar_button_size"
                        android:background="@drawable/bg_circle_bordered"
                        android:backgroundTint="@color/dagoal_gray_disabled" />

                    <ImageView
                        android:id="@+id/iv_sidebar_icon_hat"
                        android:layout_width="@dimen/icon_size_giant"
                        android:layout_height="@dimen/icon_size_giant"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/accessory_knit_hat" />
                </FrameLayout>

                <!-- 2. Glasses Slot Button -->
                <FrameLayout
                    android:id="@+id/btn_wardrobe_filter_glasses"
                    android:layout_width="@dimen/wardrobe_sidebar_button_size"
                    android:layout_height="@dimen/wardrobe_sidebar_button_size"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/view_bg_filter_glasses"
                        android:layout_width="@dimen/wardrobe_sidebar_button_size"
                        android:layout_height="@dimen/wardrobe_sidebar_button_size"
                        android:background="@drawable/bg_circle_bordered"
                        android:backgroundTint="@color/dagoal_gray_disabled" />

                    <ImageView
                        android:id="@+id/iv_sidebar_icon_glasses"
                        android:layout_width="@dimen/icon_size_extra_large"
                        android:layout_height="@dimen/icon_size_extra_large"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/accessory_reading_glasses" />
                </FrameLayout>

                <!-- 3. Clothes / Shirt Slot Button -->
                <FrameLayout
                    android:id="@+id/btn_wardrobe_filter_clothes"
                    android:layout_width="@dimen/wardrobe_sidebar_button_size"
                    android:layout_height="@dimen/wardrobe_sidebar_button_size"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/view_bg_filter_clothes"
                        android:layout_width="@dimen/wardrobe_sidebar_button_size"
                        android:layout_height="@dimen/wardrobe_sidebar_button_size"
                        android:background="@drawable/bg_circle_bordered"
                        android:backgroundTint="@color/dagoal_primary" />

                    <ImageView
                        android:id="@+id/iv_sidebar_icon_clothes"
                        android:layout_width="@dimen/icon_size_extra_large"
                        android:layout_height="@dimen/icon_size_extra_large"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/tank_top" />
                </FrameLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. Middle Content Surface (Quest Area) -->
        <FrameLayout
            android:id="@+id/dashboard_content_frame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_surface_card"
            android:elevation="@dimen/card_elevation_modal"
            app:layout_constraintBottom_toTopOf="@+id/bottom_nav_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />

        <!-- Static Background Leak Cover Panel -->
        <View
            android:id="@+id/view_bottom_cover_panel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/dagoal_surface"
            android:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/dashboard_content_frame"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 3. Bottom Navigation Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_nav_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/spacing_huge"
            android:elevation="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/bottom_nav_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:background="@drawable/bg_nav_bar"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_small"
                android:baselineAligned="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <!-- Quest Tab -->
                <LinearLayout
                    android:id="@+id/nav_quest"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nav_item_height"
                    android:layout_marginHorizontal="@dimen/spacing_tiny"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_item_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_nav_quest"
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/quest_icon"
                        app:tint="@color/dagoal_primary" />

                    <TextView
                        android:id="@+id/tv_nav_quest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_quest"
                        android:textColor="@color/dagoal_primary"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Wardrobe Tab -->
                <LinearLayout
                    android:id="@+id/nav_wardrobe"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nav_item_height"
                    android:layout_marginHorizontal="@dimen/spacing_tiny"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_item_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_nav_wardrobe"
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/wardrobe_icon"
                        app:tint="@color/dagoal_primary" />

                    <TextView
                        android:id="@+id/tv_nav_wardrobe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_wardrobe"
                        android:textColor="@color/dagoal_primary"
                        android:textSize="@dimen/text_size_small" />
                </LinearLayout>

                <!-- Shop Tab -->
                <LinearLayout
                    android:id="@+id/nav_shop"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nav_item_height"
                    android:layout_marginHorizontal="@dimen/spacing_tiny"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_item_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_nav_shop"
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/shop_icon"
                        app:tint="@color/dagoal_primary" />

                    <TextView
                        android:id="@+id/tv_nav_shop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_shop"
                        android:textColor="@color/dagoal_primary"
                        android:textSize="@dimen/text_size_small" />
                </LinearLayout>

                <!-- Me Tab -->
                <LinearLayout
                    android:id="@+id/nav_me"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nav_item_height"
                    android:layout_marginHorizontal="@dimen/spacing_tiny"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_item_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_nav_me"
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/profile_icon"
                        app:tint="@color/dagoal_primary" />

                    <TextView
                        android:id="@+id/tv_nav_me"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_me"
                        android:textColor="@color/dagoal_primary"
                        android:textSize="@dimen/text_size_small" />
                </LinearLayout>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
