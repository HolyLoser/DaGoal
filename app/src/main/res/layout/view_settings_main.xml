                android:text="@string/settings_category_notifications"
                android:textColor="@color/dagoal_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_category_notifications_desc"
                android:textColor="@color/dagoal_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/proceed"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/dagoal_primary_dark" />
    </LinearLayout>

