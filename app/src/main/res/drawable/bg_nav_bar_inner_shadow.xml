<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer primary background -->
    <item>
        <shape>
            <solid android:color="@color/dagoal_primary" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Inner shadow / depth effect (top/left darker stroke) -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="-2dp"> <!-- subtle bottom offset to emphasize top/side shadow -->
        <shape>
            <stroke
                android:width="2dp"
                android:color="#3F5231" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>