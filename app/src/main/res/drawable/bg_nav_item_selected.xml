<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state background (Surface color) -->
    <item>
        <shape>
            <solid android:color="@color/dagoal_surface" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Inner shadow / pressed effect (darker inset top and sides) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="-2dp"> <!-- Push bottom stroke outside to hide it -->
        <shape>
            <stroke
                android:width="3dp"
                android:color="#C4B28F" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>