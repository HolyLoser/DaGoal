<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom Dialog Theme -->
    <style name="DaGoalDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@drawable/bg_dialog</item>
        <item name="colorSurface">@color/dagoal_surface</item>
        <item name="android:textColorPrimary">@color/dagoal_text_primary</item>
        <item name="android:textColorSecondary">@color/dagoal_text_secondary</item>
        <item name="titleTextColor">@color/dagoal_primary_dark</item>
        <item name="colorPrimary">@color/dagoal_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/DaGoalDialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DaGoalDialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/DaGoalDialogButton</item>
        <item name="seekBarStyle">@style/DaGoalSeekBarStyle</item>
        <item name="android:seekBarStyle">@style/DaGoalSeekBarStyle</item>
    </style>

    <style name="DaGoalDialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/dagoal_primary_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DaGoalDialogButton.Positive" parent="DaGoalDialogButton">
        <item name="android:textColor">@color/dagoal_primary_dark</item>
    </style>

    <style name="DaGoalDialogButton.Negative" parent="DaGoalDialogButton">
        <item name="android:textColor">@color/dagoal_primary</item>
    </style>

    <!-- Custom SeekBar Style -->
    <style name="DaGoalSeekBarStyle" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/bg_seekbar_track</item>
        <item name="android:thumb">@drawable/bg_seekbar_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:maxHeight">28dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Custom Snackbar Theme -->
    <style name="DaGoalSnackbarStyle" parent="Widget.MaterialComponents.Snackbar">
        <item name="backgroundTint">@color/dagoal_primary</item>
        <item name="android:textColor">@color/dagoal_background_light</item>
    </style>
</resources>